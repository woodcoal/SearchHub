# ========== 服务配置 / Server ==========

# 服务监听端口 / Listening port
PORT=8787

# 监听地址，0.0.0.0 表示所有网卡 / Bind address
HOST=0.0.0.0

# 日志级别 / Log level
LOG_LEVEL=info


# ========== 目录 / Directories ==========

# 根目录，默认 ~/.search-hub（数据文件、日志、系统设置都放在它下面）
# Root directory. Defaults to ~/.search-hub — data, logs and system settings live under it.
SEARCHHUB_HOME=

# 系统设置文件（后台密码哈希 + 数据目录），默认 <SEARCHHUB_HOME>/settings.json
# 这两个配置也可以在管理后台「系统设置」里修改，界面设置优先级高于本文件
# System settings (data dir + admin password hash). Defaults to <SEARCHHUB_HOME>/settings.json.
# Both can also be changed in the admin UI, which takes precedence over this file.
SEARCHHUB_SETTINGS_FILE=

# 数据存储文件（供应商设置 + 供应商密钥密文 + API Key 哈希）
# 留空则使用 <SEARCHHUB_HOME>/store.json
# Data store: provider config + encrypted provider keys + caller API key hashes.
# Defaults to <SEARCHHUB_HOME>/store.json.
DATA_FILE=


# ========== 日志 / Logging ==========

# 日志目录，留空则使用 <SEARCHHUB_HOME>/log
# Log directory. Defaults to <SEARCHHUB_HOME>/log.
SEARCHHUB_LOG_DIR=

# 调用日志持久化文件（JSONL，每次密钥/供应商尝试一行，保留最近 1000 条）
# 留空则使用 <SEARCHHUB_LOG_DIR>/calls.jsonl
# Persistent call log (JSONL, one line per key/provider attempt, last 1000 kept).
# Defaults to <SEARCHHUB_LOG_DIR>/calls.jsonl.
SEARCHHUB_CALL_LOG_FILE=

# 日志保留天数，超过会被自动清理；设为 0 表示永久保留
# Log retention in days; older files are pruned on startup. 0 = keep forever.
SEARCHHUB_LOG_RETENTION_DAYS=14

# 是否同时把日志输出到控制台，设为 false 则只写文件
# Also print logs to stdout (useful for `docker logs`). false = write to file only.
SEARCHHUB_LOG_STDOUT=true


# ========== 安全 / Security ==========

# 【强烈建议设置】供应商密钥加密主密钥。留空则密钥明文落盘（会有启动告警）
# 【设置之后不要更改】它是解密已落盘密钥的主密钥，改了会导致旧密钥无法解密
# 生成方式 / Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Master key for AES-256-GCM encryption of provider keys. Empty = keys are stored in
# plaintext and a warning is printed on startup.
# Set this ONCE and never change it — changing it makes already-stored keys undecryptable.
SEARCHHUB_SECRET=change-me-to-a-long-random-string

# 【必须设置】管理后台登录密码。留空则每次启动随机生成并打印在启动日志中
# 生成方式 / Generate with:
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
# Admin UI password. Empty = a random password is generated on every start and printed to the log.
# Do not keep the placeholder value on any reachable deployment.
SEARCHHUB_ADMIN_PASSWORD=change-me-admin-password

# 登录会话有效期（毫秒），默认 8 小时
# Admin session TTL in milliseconds. Default: 8 hours.
SEARCHHUB_SESSION_TTL_MS=28800000

# 可选：主 API Key（环境变量形式），优先级等同于数据库里的 API Key，便于应急 / CI
# 调用 /api/search 时通过 x-api-key 传入
# Optional master API key (env form); equivalent to an API key stored in the data file.
# Pass it as the `x-api-key` header when calling /api/search. Useful for CI / break-glass access.
SEARCHHUB_API_TOKEN=

# 可选：主管理令牌（环境变量形式），便于脚本直接调用 /api/admin/*，无需登录
# Optional master admin token (env form), so scripts can call /api/admin/* without logging in.
SEARCHHUB_ADMIN_TOKEN=


# ========== 首次启动播种供应商密钥 / Provider key seeding ==========

# 首次启动时可选：从环境变量播种供应商密钥（多个用英文逗号分隔），写入数据文件后即可在界面管理
# Optional: seed provider keys on first start (comma-separated). Once written to the data file
# they can be managed from the admin UI.
SERPER_KEYS=
TAVILY_KEYS=
EXA_KEYS=
ANYSEARCH_KEYS=
