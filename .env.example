# 服务配置
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# 根目录，默认 ~/.search-hub（数据文件与日志都放在它下面）
SEARCHHUB_HOME=

# 数据存储文件（供应商设置 + 供应商密钥密文 + API Key 哈希）
# 留空则使用 <SEARCHHUB_HOME>/store.json
DATA_FILE=

# 日志目录，留空则使用 <SEARCHHUB_HOME>/log
SEARCHHUB_LOG_DIR=

# 日志保留天数，超过会被自动清理；设为 0 表示永久保留
SEARCHHUB_LOG_RETENTION_DAYS=14

# 是否同时把日志输出到控制台，设为 false 则只写文件
SEARCHHUB_LOG_STDOUT=true

# 【强烈建议设置】供应商密钥加密主密钥。留空则密钥明文落盘（会有启动告警）
SEARCHHUB_SECRET=change-me-to-a-long-random-string

# 【必须设置】管理后台登录密码。留空则每次启动随机生成并打印在启动日志中
SEARCHHUB_ADMIN_PASSWORD=change-me-admin-password

# 登录会话有效期（毫秒），默认 8 小时
SEARCHHUB_SESSION_TTL_MS=28800000

# 可选：主 API Key（环境变量形式），优先级等同于数据库里的 API Key，便于应急 / CI
# 调用 /api/search 时通过 x-api-key 传入
SEARCHHUB_API_TOKEN=

# 可选：主管理令牌（环境变量形式），便于脚本直接调用 /api/admin/*，无需登录
SEARCHHUB_ADMIN_TOKEN=

# 首次启动时可选：从环境变量播种供应商密钥（多个用英文逗号分隔），写入数据文件后即可在界面管理
SERPER_KEYS=
EXA_KEYS=
