{
  "name": "searchhub",
  "version": "0.1.3",
  "private": false,
  "type": "module",
  "description": "统一搜索网关：聚合 Serper / Exa 等多家搜索 API，统一协议、集中管理密钥、自动轮换与容灾切换",
  "author": {
    "name": "木炭",
    "email": "woodcoal@qq.com",
    "url": "https://github.com/woodcoal"
  },
  "license": "MIT",
  "homepage": "https://github.com/woodcoal/SearchHub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woodcoal/SearchHub.git"
  },
  "bugs": {
    "url": "https://github.com/woodcoal/SearchHub/issues"
  },
  "keywords": [
    "search",
    "search-api",
    "serper",
    "exa",
    "gateway",
    "api-key",
    "key-rotation",
    "cli"
  ],
  "main": "dist/index.js",
  "bin": {
    "searchhub": "dist/cli.js"
  },
  "files": [
    "dist",
    "web/dist",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.2.0",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
